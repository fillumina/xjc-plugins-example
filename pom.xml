<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.fillumina</groupId>
  <artifactId>xjc-plugins-example</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>xjc-plugins-example</name>

  <description>Examples of the three Jakarta XJC and CXF plugins together and with equals/hashCode generation.</description>
  <url>https://github.com/fillumina/xjc-plugins-example/</url>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>three-plugins</module>
    <module>equals-hashcode</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <cxf.version>4.2.3</cxf.version>
    <jaxb.version>4.0.9</jaxb.version>
    <jaxb.plugins.version>4.0.16</jaxb.plugins.version>
    <hibernate-validator.version>9.1.4.Final</hibernate-validator.version>
    <junit.version>6.1.3</junit.version>
    <!-- Each version can be overridden to test a release or a locally installed snapshot. -->
    <cxf-validation-frontend.version>1.0.0-SNAPSHOT</cxf-validation-frontend.version>
    <xjc-bean-validation-plugin.version>1.0.0-SNAPSHOT</xjc-bean-validation-plugin.version>
    <xjc-primitives-plugin.version>1.0.0-SNAPSHOT</xjc-primitives-plugin.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
